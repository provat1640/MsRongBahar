# =========================================================================
# M/S Rong Bahar Environment Configuration (100% Free Cloud Stack)
# =========================================================================

# -------------------------------------------------------------------------
# 1. DATABASE (Supabase / Neon PostgreSQL with Serverless Connection Pooling)
# -------------------------------------------------------------------------
# Pooled connection string (Port 6543 on Supabase / pooler on Neon) used by NestJS runtime:
DATABASE_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Direct unpooled connection string (Port 5432) used by Prisma CLI for migrations:
DIRECT_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------------------
# 2. REDIS CACHE & DISTRIBUTED LOCKS (Upstash Serverless Free Tier)
# -------------------------------------------------------------------------
# Option A: Serverless REST API (Recommended - No raw TCP sockets required)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Option B: Standard TLS Redis URL (rediss:// protocol)
REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# -------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -------------------------------------------------------------------------
JWT_SECRET="rong-bahar-production-jwt-secret-key-2026-pakundia"
JWT_EXPIRES_IN="7d"

# -------------------------------------------------------------------------
# 4. SERVICE URLs & CORS CONFIGURATION
# -------------------------------------------------------------------------
PORT=4000
NODE_ENV="production"

# Backend API URL:
BACKEND_URL="https://ms-rong-bahar-api.onrender.com"
NEXT_PUBLIC_API_URL="https://ms-rong-bahar-api.onrender.com/api"

# Frontend Storefront URL (Namecheap domain & Vercel):
FRONTEND_URL="https://msrongbahar.me"

# -------------------------------------------------------------------------
# 5. GITHUB ACTIONS & CI/CD DEPLOYMENT SECRETS (Set via `gh secret set`)
# -------------------------------------------------------------------------
# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."
# REDIS_URL="rediss://..." (or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN)
# VERCEL_TOKEN="your_vercel_token"
# VERCEL_ORG_ID="your_vercel_org_id"
# VERCEL_PROJECT_ID="your_vercel_project_id"
# RENDER_DEPLOY_HOOK="https://api.render.com/deploy/srv-xxx?key=yyy"
