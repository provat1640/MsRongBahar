# ==========================================
# M/S Rong Bahar Environment Configuration
# ==========================================

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ms_rong_bahar_db?schema=public"

# Redis Cache & Session Connection (Redis 7)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="rong-bahar-super-secret-production-jwt-key-2026"

# Service Ports & URLs
PORT=4000
BACKEND_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Cloud & Container Deployment (Cloud Run / AWS ECS / Fly.io)
DOCKER_REGISTRY="ghcr.io/yourorg"
IMAGE_TAG="latest"
