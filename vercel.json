{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd apps/frontend && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "apps/frontend/.next",
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 */12 * * *"
    }
  ]
}
