datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  password  String
  role      String   @default("USER") // USER or ADMIN
  address   String?
  district  String?
  thana     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  image       String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Unit {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "Dimension (mm)", "Weight (kg/gm)", "Volume (Litre)", "Fluid Ounce (oz)"
  category  String   @default("General") // Dimension, Weight, Volume, Quantity, Custom
  createdAt DateTime @default(now())
}

model Product {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  basePrice   Float
  stock       Int              @default(0)
  sku         String           @unique
  images      String           // JSON string of image URLs
  isActive    Boolean          @default(true)
  unit        String           @default("pcs")
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String      // e.g., "50mm Lock", "60mm Lock", "70mm Lock", "1 Litre", "500g"
  price      Float
  stock      Int         @default(0)
  sku        String      @unique
  orderItems OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  phone           String
  deliveryAddress String
  district        String
  thana           String
  totalAmount     Float
  deliveryFee     Float       @default(60)
  paymentMethod   String      // COD, BKASH, NAGAD
  paymentStatus   String      @default("PENDING") // PENDING, VERIFIED, FAILED
  orderStatus     String      @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  bkashTrxId      String?
  paymentSenderNo String?
  items           OrderItem[]
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Float
}
